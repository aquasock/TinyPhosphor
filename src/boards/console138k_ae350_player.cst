// SPDX-License-Identifier: GPL-3.0-only
//
// TinyPhosphor player + AE350 + 32 MiB SDRAM pinout, open-flow build.
//
// Derived from Tang-Phosphor's console138k_merged.cst with the DDR3 and AE350
// entries removed.  The player owns sys_clk, HDMI, the BL616 UART, the two
// controller USB ports and both PMOD sockets; the AE350 stub's DDR ports are
// not exposed by tiny_phosphor_player_top.
//
// PLL placement follows the measured GW5AST-138C rules: the HDMI 27 MHz
// reference and the 371.25/74.25 MHz pixel PLL sit on the right edge, with the
// pixel PLL at PLL_R[3] beside the TMDS serialisers.  The 12 MHz USB clock is
// at PLL_R[0].  The I2S2 pair is on the left edge because the right edge has
// only four sites and the first image's acceptance gate is HDMI video; audio
// is best-effort until the left-side clock route is measured.

IO_LOC "sys_clk" V22;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF;

// HDMI transmitter
IO_LOC "tmds_clk_p" G15;
IO_PORT "tmds_clk_p" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_LOC "tmds_clk_n" G16;
IO_PORT "tmds_clk_n" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_LOC "tmds_d_p[0]" J14;
IO_PORT "tmds_d_p[0]" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_LOC "tmds_d_n[0]" H14;
IO_PORT "tmds_d_n[0]" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_LOC "tmds_d_p[1]" J15;
IO_PORT "tmds_d_p[1]" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_LOC "tmds_d_n[1]" H15;
IO_PORT "tmds_d_n[1]" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_LOC "tmds_d_p[2]" K17;
IO_PORT "tmds_d_p[2]" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_LOC "tmds_d_n[2]" J17;
IO_PORT "tmds_d_n[2]" PULL_MODE=NONE IO_TYPE=LVCMOS33D;

// Onboard MAX98357A mono speaker on J5.  Bank 5 is 3.3 V on the 138K SOM;
// the "1.5 V" note in the SOM pin table applies to the 60K part.  PA_EN is
// the amplifier's SD_MODE/ enable input, active high on this board.
IO_LOC "i2s_bclk" Y17;
IO_LOC "i2s_lrck" AB17;
IO_LOC "i2s_dout" AA16;
IO_LOC "pa_en"    Y14;
IO_PORT "i2s_bclk" IO_TYPE=LVCMOS33;
IO_PORT "i2s_lrck" IO_TYPE=LVCMOS33;
IO_PORT "i2s_dout" IO_TYPE=LVCMOS33;
IO_PORT "pa_en"    IO_TYPE=LVCMOS33;

// UART to the external BL616 MCU
IO_LOC "UART_RXD" V14;
IO_LOC "UART_TXD" U15;
IO_PORT "UART_RXD" IO_TYPE=LVCMOS33;
IO_PORT "UART_TXD" IO_TYPE=LVCMOS33;

// Controller-facing low-speed USB ports (USB1 is the left port)
IO_LOC "usb1_dp" H13;
IO_PORT "usb1_dp" IO_TYPE=LVCMOS33;
IO_LOC "usb1_dn" G13;
IO_PORT "usb1_dn" IO_TYPE=LVCMOS33;
IO_LOC "usb2_dp" M15;
IO_PORT "usb2_dp" IO_TYPE=LVCMOS33;
IO_LOC "usb2_dn" M16;
IO_PORT "usb2_dn" IO_TYPE=LVCMOS33;

// PMOD0, the socket furthest from the HDMI port.
IO_LOC "pmod0_io[0]" V18;
IO_LOC "pmod0_io[1]" V19;
IO_LOC "pmod0_io[2]" G21;
IO_LOC "pmod0_io[3]" G22;
IO_LOC "pmod0_io[4]" F18;
IO_LOC "pmod0_io[5]" E18;
IO_LOC "pmod0_io[6]" C22;
IO_LOC "pmod0_io[7]" B22;

// PMOD1, the socket beside the HDMI port.
IO_LOC "pmod1_io[0]" W19;
IO_LOC "pmod1_io[1]" W20;
IO_LOC "pmod1_io[2]" F19;
IO_LOC "pmod1_io[3]" F20;
IO_LOC "pmod1_io[4]" E22;
IO_LOC "pmod1_io[5]" D22;
IO_LOC "pmod1_io[6]" E21;
IO_LOC "pmod1_io[7]" D21;

IO_PORT "pmod0_io[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "pmod0_io[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "pmod0_io[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "pmod0_io[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "pmod0_io[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "pmod0_io[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "pmod0_io[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "pmod0_io[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

IO_PORT "pmod1_io[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "pmod1_io[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "pmod1_io[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "pmod1_io[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "pmod1_io[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "pmod1_io[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "pmod1_io[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "pmod1_io[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// The AE350 owns PLL_R[0] at the top level.  The player's HDMI chain keeps
// PLL_R[1] and PLL_R[3]; the I2S audio PLL takes the free PLL_R[2].  The USB
// 12 MHz and I2S reference PLLs are on the left; the I2S reference was suspect
// in the player-only image, so audio remains best-effort until it is measured.
INS_LOC "cpu_pll.PLL_inst"                 PLL_R[0];
INS_LOC "core.clock_27mhz.PLL_inst"       PLL_R[1];
INS_LOC "core.clock_hdmi.PLL_inst"        PLL_R[3];
INS_LOC "core.pixel_div"                  RIGHTSIDE[4];
INS_LOC "core.i2s2_audio_clock.PLL_inst"  PLL_R[2];
INS_LOC "core.i2s2_reference_clock.PLL_inst" PLL_L[0];
INS_LOC "core.controller_clock.PLL_inst"  PLL_L[1];

// J9 SDRAM for the AE350, from TinyNES console138k (MIT).
IO_LOC "sdram_clk" B17;      // 20
IO_LOC "sdram_cs_n" F21;     // 33
IO_LOC "sdram_ras_n" F16;    // 32
IO_LOC "sdram_cas_n" E17;    // 31
IO_LOC "sdram_we_n" D16;     // 27
IO_LOC "sdram_ba[0]" F15;    // 34
IO_LOC "sdram_ba[1]" C20;    // 35
IO_LOC "sdram_a[0]" D19;     // 37
IO_LOC "sdram_a[1]" E19;     // 38
IO_LOC "sdram_a[2]" C19;     // 39
IO_LOC "sdram_a[3]" C18;     // 40
IO_LOC "sdram_a[4]" E16;     // 28
IO_LOC "sdram_a[5]" D15;     // 25
IO_LOC "sdram_a[6]" D14;     // 26
IO_LOC "sdram_a[7]" A19;     // 23
IO_LOC "sdram_a[8]" A18;     // 24
IO_LOC "sdram_a[9]" C17;     // 21
IO_LOC "sdram_a[10]" D20;    // 36
IO_LOC "sdram_a[11]" D17;    // 22
IO_LOC "sdram_a[12]" B18;    // 19
IO_LOC "sdram_dqm[0]" F14;   // 29
IO_LOC "sdram_dqm[1]" F13;   // 30
IO_LOC "sdram_dq[0]" E14;    // 1
IO_LOC "sdram_dq[1]" E13;    // 2
IO_LOC "sdram_dq[2]" C15;    // 3
IO_LOC "sdram_dq[3]" C14;    // 4
IO_LOC "sdram_dq[4]" B13;    // 5
IO_LOC "sdram_dq[5]" C13;    // 6
IO_LOC "sdram_dq[6]" A14;    // 7
IO_LOC "sdram_dq[7]" A13;    // 8
IO_LOC "sdram_dq[8]" B21;    // 18
IO_LOC "sdram_dq[9]" A21;    // 17
IO_LOC "sdram_dq[10]" B20;   // 16
IO_LOC "sdram_dq[11]" A20;   // 15
IO_LOC "sdram_dq[12]" A15;   // 14
IO_LOC "sdram_dq[13]" A16;   // 13
IO_LOC "sdram_dq[14]" B15;   // 10
IO_LOC "sdram_dq[15]" B16;   // 9
IO_PORT "sdram_clk" IO_TYPE=LVCMOS33;
IO_PORT "sdram_cs_n" IO_TYPE=LVCMOS33;
IO_PORT "sdram_ras_n" IO_TYPE=LVCMOS33;
IO_PORT "sdram_cas_n" IO_TYPE=LVCMOS33;
IO_PORT "sdram_we_n" IO_TYPE=LVCMOS33;
IO_PORT "sdram_ba[0]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_ba[1]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_a[0]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_a[1]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_a[2]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_a[3]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_a[4]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_a[5]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_a[6]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_a[7]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_a[8]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_a[9]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_a[10]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_a[11]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_a[12]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_dqm[0]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_dqm[1]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_dq[0]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_dq[1]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_dq[2]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_dq[3]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_dq[4]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_dq[5]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_dq[6]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_dq[7]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_dq[8]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_dq[9]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_dq[10]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_dq[11]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_dq[12]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_dq[13]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_dq[14]" IO_TYPE=LVCMOS33;
IO_PORT "sdram_dq[15]" IO_TYPE=LVCMOS33;
